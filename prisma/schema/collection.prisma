model Collection {
  id String @id @default(cuid())

  name        String
  slug        String
  description String?
  coverUrl    String? @map("cover_url")
  isPublic    Boolean @default(true) @map("is_public")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Подборка может смешивать типы: «Ведьмак» = игра + книга + сериал
  titles CollectionTitle[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Slug уникален внутри пользователя: двое могут назвать подборку «Ведьмак»
  @@unique([userId, slug])
  @@index([userId])
  @@index([isPublic])
  @@map("collections")
}

/// Связь подборки с тайтлом. Явная модель, а не неявная many-to-many:
/// нужен addedAt, чтобы показывать обложки в порядке добавления
model CollectionTitle {
  collectionId String     @map("collection_id")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  titleId String @map("title_id")
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now()) @map("added_at")

  @@id([collectionId, titleId])
  @@index([titleId])
  @@map("collection_titles")
}
