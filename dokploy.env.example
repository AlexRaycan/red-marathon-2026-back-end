# Обязательные значения. Настоящие секреты вводятся в Dokploy, не в Git.
POSTGRES_USER=red_marathon
POSTGRES_PASSWORD=replace_with_64_hex_characters
POSTGRES_DB=red_marathon
JWT_SECRET=replace_with_another_64_hex_characters

# Порт доступен только на 127.0.0.1 сервера и открывается ноутбуку через SSH.
API_HOST_PORT=14000

# Необязательные ключи. Без них соответствующие интеграции не работают.
TMDB_API_KEY=
RAWG_API_KEY=
GOOGLE_BOOKS_API_KEY=
OPENROUTER_API_KEY=
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_BUNDLE_ID=
APPLE_PRIVATE_KEY=
APPLE_ENVIRONMENT=sandbox
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON=
